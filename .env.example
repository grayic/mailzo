# Copy this file to .env and fill it in. That copy is never committed.

# Browser sign-in for Google and Microsoft.
# A value left empty keeps that sign-in turned off.

# From Google Cloud: Google Auth platform > Clients > a client of type Desktop app.
# "Continue with Google" for Mailzo accounts also needs Google set up on Mailzo's
# account server.
INBOX_GOOGLE_CLIENT_ID=
INBOX_GOOGLE_CLIENT_SECRET=

# From Microsoft Entra: App registrations > your app > Application (client) ID.
INBOX_MICROSOFT_CLIENT_ID=

# Optional: your own account server, instead of the default one.
# INBOX_ACCOUNT_SERVER=https://account.example.com
