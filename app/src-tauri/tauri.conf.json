{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mailzo",
  "version": "1.0.0",
  "identifier": "com.grayic.inbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5177",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: http: inboximage: http://inboximage.localhost",
        "font-src": "'self' data:",
        "frame-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https: http: inboximage: http://inboximage.localhost",
        "font-src": "'self' data:",
        "frame-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:5177"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "files": {
        "Resources/Chime.wav": "sounds/Chime.wav",
        "Resources/Glass.wav": "sounds/Glass.wav",
        "Resources/Keys.wav": "sounds/Keys.wav",
        "Resources/Marimba.wav": "sounds/Marimba.wav"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MzBEMkVCNzlCNzA1MzcKUldRM0JiZDU2OUl3U0dxc2ZXbGRUSHpQc0hQaURqN05yMDB3VTE0UHBmWmV2Y0hLdHRVMlJjWngK",
      "endpoints": [
        "https://updates.getmailzo.com/stable.json"
      ]
    }
  }
}
